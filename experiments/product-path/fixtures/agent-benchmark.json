      {"tool": "inspect", "args": {"ids": ["c"]}},
      {"tool": "plan_edit", "args": {"base_revision": 1, "edits": [{"op": "replace_source", "clip_id": "c", "source": "asset://c-alt"}]}},
      {"tool": "commit_edit", "args": {"plan_token": "plan-2"}},
      {"tool": "verify"}
