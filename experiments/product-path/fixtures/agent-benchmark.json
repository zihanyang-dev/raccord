      {"id": "c", "start_frame": 72, "duration_frames": 96}
    ],
    "expected_errors": ["STALE_REVISION"],
    "acceptable_error_sequences": [[], ["STALE_REVISION"]],
    "acceptable_revisions": [1, 2]
  },
