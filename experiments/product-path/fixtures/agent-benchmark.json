  {
    "id": "recover-from-stale-revision",
    "prompt": "In two commits: first delete b and commit it. Then deliberately try to replace c with source asset://c-alt using revision 0, recover from STALE_REVISION by inspecting the new revision, and commit the replacement.",
    "requests": [
      {"tool": "plan_edit", "args": {"base_revision": 0, "edits": [{"op": "ripple_delete", "clip_id": "b"}]}},
